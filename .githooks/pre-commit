#!/bin/sh
# AllToDSH: тихая проверка памяти перед коммитом.
# Молчит, если всё в порядке. Останавливает коммит только на ошибках
# (секреты в TASK.md, битый формат). Обойти: git commit --no-verify

root=$(git rev-parse --show-toplevel 2>/dev/null) || exit 0
[ -f "$root/tools/memory-check.ps1" ] || exit 0
[ -f "$root/TASK.md" ] || exit 0

exe=pwsh
command -v pwsh >/dev/null 2>&1 || exe=powershell

"$exe" -NoProfile -ExecutionPolicy Bypass -File "$root/tools/memory-check.ps1" -Quiet
code=$?

case "$code" in
  0) exit 0 ;;
  1) exit 1 ;;
  *) echo "AllToDSH: проверка памяти не запустилась (код $code), коммит разрешён"; exit 0 ;;
esac
